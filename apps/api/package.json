{
  "name": "@commerce/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "db:migrate": "ts-node -r tsconfig-paths/register src/database/run-migrations.ts",
    "db:revert": "ts-node -r tsconfig-paths/register src/database/run-migrations.ts --revert",
    "admin:bootstrap": "ts-node -r tsconfig-paths/register src/admin/bootstrap-admin.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@commerce/contracts": "file:../../packages/contracts",
    "@commerce/data-access": "file:../../packages/data-access",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/typeorm": "^11.0.3",
    "casbin": "^5.51.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-redis": "^8.1.0",
    "express-session": "^1.19.0",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.8.0",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "typeorm-adapter": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.2.8",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
