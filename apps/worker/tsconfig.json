{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "../..",
    "paths": {
      "@commerce/data-access": ["../../packages/data-access/src/index.ts"]
    },
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../../packages/data-access/src/**/*.ts"]
}
