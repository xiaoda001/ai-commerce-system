# 将本文件复制为仓库根目录的 .env，并替换示例密码；.env 不要提交到 Git。
# NestJS API 和 Worker 在宿主机运行时，使用以下本机服务地址。

# MySQL：数据库连接配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=commerce
DB_USER=commerce_app
# 本地开发数据库密码；请替换为你创建 commerce_app 用户时设置的密码。
DB_PASSWORD=replace-local-only

# Redis：连接地址。若 NestJS 在 Docker 网络中运行，应改用 Redis 服务名。
REDIS_URL=redis://127.0.0.1:6379

# Kafka：初始 Broker 地址；若 NestJS 在 Docker 网络中运行，应配置容器可访问的 advertised listener。
KAFKA_BROKERS=127.0.0.1:9092

# Session：使用随机值签署浏览器 Cookie；请生成至少 32 字节的随机密钥，不要复用示例值。
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# Session 服务端过期秒数；有效范围为 300 到 604800 秒。
SESSION_TTL_SECONDS=86400
# 本地 HTTP 开发设为 false；部署到 HTTPS 时设为 true。
SESSION_COOKIE_SECURE=false
# 允许携带 Cookie 访问 API 的前端 Origin，多个地址用逗号分隔。
WEB_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3002

# 首次创建超级管理员时临时设置；初始化成功后从本地 .env 删除这两项。
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=请设置至少 8 位的唯一密码

# NestJS API HTTP 服务端口
API_PORT=3001
